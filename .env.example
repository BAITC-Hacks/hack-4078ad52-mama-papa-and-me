# Server-only configuration for the local application.
# Copy to .env only if no local .env exists. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
SQLITE_PATH=./var/akim.sqlite

# Cloud deployment (Netlify + Neon). Set secrets in Netlify, never NEXT_PUBLIC_.
DEPLOY_TARGET=local
DATABASE_URL=
APP_ORIGIN=
WORKER_SECRET=
# Local default is 3 minutes; Netlify default is 12 (maximum 12).
# AI_MAX_ANALYSIS_MINUTES=12
# Maximum admitted analyses per UTC day across all visitors (Neon only).
AI_DAILY_ANALYSIS_LIMIT=50
